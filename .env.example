# Copy this file to ".env" and fill in real values there.
# .env is gitignored -- .env.example is the only one that should ever be committed.

# Opt-in (image sent to their cloud) -- only run when the upload form's checkbox is ticked.
REALITY_DEFENDER_API_KEY=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Automatic (hash-only lookup, nothing uploaded) -- runs on every upload.
VIRUSTOTAL_API_KEY=
